rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The only admin is a single Firebase Auth account, identified by its UID.
    // A UID cannot be chosen or forged by a visitor, and nothing personal
    // (such as an e-mail address) lives in this public file.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "xrBbNGmup7fwwk1JhNRE03gOQW82";
    }

    function isNonEmptyString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function isValidEncryptedEnvelope() {
      return request.resource.data.keys().hasOnly([
          "version",
          "algo",
          "encryptedKey",
          "iv",
          "ciphertext",
          "createdAt"
        ]) &&
        request.resource.data.version == 1 &&
        request.resource.data.algo == "RSA-OAEP/AES-GCM" &&
        isNonEmptyString(request.resource.data.encryptedKey, 4096) &&
        isNonEmptyString(request.resource.data.iv, 256) &&
        isNonEmptyString(request.resource.data.ciphertext, 20000) &&
        request.resource.data.createdAt == request.time;
    }

    function isValidLabelUpload() {
      return request.resource.data.keys().hasOnly([
          "barcode",
          "productName",
          "source",
          "image",
          "checked",
          "createdAt"
        ]) &&
        isNonEmptyString(request.resource.data.barcode, 64) &&
        isNonEmptyString(request.resource.data.productName, 160) &&
        isNonEmptyString(request.resource.data.source, 64) &&
        request.resource.data.image is string &&
        request.resource.data.image.size() > 0 &&
        request.resource.data.image.size() <= 1100000 &&
        request.resource.data.checked is bool &&
        request.resource.data.createdAt == request.time;
    }

    match /contactMessages/{docId} {
      allow create: if isValidEncryptedEnvelope();
      allow read, list, update, delete: if isAdmin();
    }

    match /waitlist/{docId} {
      allow create: if isValidEncryptedEnvelope();
      allow read, list, update, delete: if isAdmin();
    }

    match /labelUploads/{docId} {
      allow create: if isValidLabelUpload();
      allow read, list, update, delete: if isAdmin();
    }

    // First-party anonymous analytics (written only after visitor consent).
    // Create-only for anyone, with strict shape and size limits; read and
    // delete for admins. Turn on a Firestore TTL policy on "expireAt".
    function isShortId(value) {
      return value is string && value.size() >= 8 && value.size() <= 40;
    }

    function isValidAnalyticsBatch() {
      let d = request.resource.data;
      return d.keys().hasOnly(["v", "vid", "sid", "ts", "expireAt", "ctx", "ev"])
        && d.v == 1
        && isShortId(d.vid)
        && isShortId(d.sid)
        && d.ts is int
        && d.ts > request.time.toMillis() - 86400000
        && d.ts < request.time.toMillis() + 86400000
        && d.expireAt is timestamp
        && d.expireAt > request.time
        && d.expireAt < request.time + duration.value(400, 'd')
        && d.ctx is map
        && d.ctx.keys().hasOnly([
          "lang", "dev", "vw", "os", "br", "tz", "ref", "us", "um", "uc",
          "rv", "vc", "lp", "touch"
        ])
        && d.ev is list
        && d.ev.size() > 0
        && d.ev.size() <= 60;
    }

    match /analytics_batches/{docId} {
      allow create: if isValidAnalyticsBatch();
      allow get, list, delete: if isAdmin();
      allow update: if false;
    }

    match /secure/adminPrivateKey {
      allow get: if isAdmin();
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
